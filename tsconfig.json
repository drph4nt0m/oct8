{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "#core/*": ["./src/core/*"],
      "#infra/*": ["./src/infra/*"],
      "#api/*": ["./src/api/*"],
      "#services/*": ["./src/services/*"],
      "#tests/*": ["./src/tests/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "scripts"]
}
